# Application Settings
APP_NAME="YouTube Video Language Converter"
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=1024
DEFAULT_MAX_DURATION=600
USE_GPU=auto
WHISPER_MODEL=base
OUTPUT_FORMAT=mp4

# Providers: auto, gemini, google, demucs, spectral_filter
TRANSLATION_PROVIDER=auto
TTS_PROVIDER=auto
SEPARATION_PROVIDER=auto

# Storage directories
TEMP_DIRECTORY=./temporary_files
OUTPUT_DIRECTORY=./outputs

# Optional: Cloud AI Acceleration (Gemini API for high-precision dubbing and multimodal transcription)
GEMINI_API_KEY=""

# Database
DATABASE_URL="sqlite:///./database.sqlite"
